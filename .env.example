# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 커밋하지 않는다.

GEMINI_API_KEY=dummy

OPENAI_API_KEY=
# OPENAI_MODEL은 기능별 설정이 없는 기존 환경의 전환용 기본값입니다.
OPENAI_MODEL=gpt-5.6-terra
AI_CHAT_MODEL=gpt-5.6-terra
AI_CHAT_REASONING_EFFORT=low
AI_CHAT_MAX_OUTPUT_TOKENS=2000
AI_ASSISTANT_MODEL=gpt-5.6-terra
AI_ASSISTANT_REASONING_EFFORT=low
AI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
AI_LIVE_CONTEXT_MODEL=gpt-5.6-luna
AI_LIVE_CONTEXT_REASONING_EFFORT=low
AI_LIVE_CONTEXT_MAX_OUTPUT_TOKENS=1200
AI_SUMMARY_MODEL=gpt-5.6-sol
AI_SUMMARY_REASONING_EFFORT=medium
AI_SUMMARY_MAX_OUTPUT_TOKENS=8000
OPENAI_BASE_URL=https://api.openai.com/v1

# Soniox 실시간 STT. 값은 .env 에만 채운다.
SONIOX_API_KEY=

# 실제 OpenAI 연결 테스트를 실행할 때만 true 로 변경한다.
RUN_OPENAI_SMOKE_TEST=false

# 실제 AI Client 연동 전에는 Fake 구현체를 명시적으로 사용한다.
AI_CHAT_CLIENT=fake
AI_ASSISTANT_CLIENT=fake
AI_LIVE_CONTEXT_CLIENT=fake
AI_SUMMARY_CONTEXT_SOURCE=mock
RUN_OPENAI_LIVE_CONTEXT_SMOKE_TEST=false
